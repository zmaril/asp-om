% ===========================================================================
% Opus Magnum -- Picat planner encoding: STABILIZED WATER, FREE LAYOUT
% ===========================================================================
% Same puzzle spec as stabilized_water.pi (extracted from omsim's
% test/puzzle/campaign/ch1-and-prologue/P007.puzzle -- see that file's
% header for the spec and the full list of simplifications), but the
% MACHINE LAYOUT IS A DECISION VARIABLE.  The solver chooses:
%   * arm base hex + initial orientation (place_arm),
%   * the calcification glyph hex (place_calc),
%   * the bonder glyph's two adjacent hexes (place_bonder)
% via an initial setup phase of cost-1 placement actions (constant +3
% offset, so best_plan is still instruction-optimal; see case2_free.pi).
%
% Fixed by the instance (they are the puzzle's own I/O): the reagent
% input hex (1,0) (respawning water, pool 2) and the product output
% hexes salt@(0,-1) -- water@(1,-1).
%
% Placement legality (mirrors the game's no-overlapping-parts rule):
% every part hex on the board; base, calc, bonder cells, spawn and the
% two output hexes pairwise disjoint; gripper hex on the board.
%
% PRUNING (on by default; `picat stabilized_water_free.pi noprune` for
% the raw search).  All prunings are sound reachability arguments, not
% heuristics:
%   * base adjacent to the spawn hex: atoms enter the world only there,
%     and with a single length-1 arm an atom leaves a hex only by being
%     grabbed (parts may not sit on the spawn hex, so no glyph can act
%     on an atom before it is first grabbed);
%   * base adjacent to at least one output hex: the final drop leaves
%     the held atom on the gripper hex, which is at distance 1;
%   * calc hex and bonder hexes within distance 2 of the base: an atom
%     only ever occupies the spawn hex, the gripper hex (dist 1), or a
%     hex it was swung/dropped onto as part of a held 2-atom molecule
%     (dist <= 2), so parts farther out can never trigger.
% ===========================================================================

import planner.

main => solve(prune).
main(Args) => (Args = [A|_], A == "noprune" -> solve(noprune) ; solve(prune)).

solve(Mode) =>
    get_global_map().put(prune_mode, Mode),
    printf("mode: %w%n", Mode),
    % no arm/glyphs yet; the first water spawns via mk_next at t=0
    mk_next([], [], [], 0, [], [], [arm, calc, bonder], S0),
    print_layout(S0),
    time(best_plan(S0, 20, Plan, Cost)),
    println(plan_found),
    foreach (A in Plan) printf("PLAN %w%n", A) end,
    NPlace = len([A : A in Plan, is_placement(A)]),
    printf("cost = %d (%d placements + %d instructions)%n",
           Cost, NPlace, Cost - NPlace).

is_placement(A) => membchk(A[1], [place_arm, place_calc, place_bonder]).

pruning() => get_global_map().get(prune_mode, prune) == prune.

% hexes reserved for the puzzle's own I/O parts (input + product output)
io_cells() = [{1,0}, {0,-1}, {1,-1}].

hex_dist(Q1,R1,Q2,R2) = (abs(Q1-Q2) + abs(R1-R2) + abs(Q1+R1-Q2-R2)) div 2.

final({Arms, Atoms, Bonds, _NSp, _Calc, _Bd, []}) =>
    member({X, salt,  0, -1}, Atoms),
    member({Y, water, 1, -1}, Atoms),
    membchk(norm_pair(X,Y), Bonds),
    foreach ({_,_,_,_,_,H} in Arms) H == none end.

% -- instance parameters ------------------------------------------------------
radius() = 2.
spawn_pool() = 2.            % product needs exactly 2 atoms
spawn_cell() = {1,0}.
spawn_type() = water.

print_layout({Arms, Atoms, Bonds, _, Calc, Bd, _}) =>
    printf("LAYOUT radius %d%n", radius()),
    {SQ,SR} = spawn_cell(),
    printf("LAYOUT spawn %d %d %w %d%n", SQ, SR, spawn_type(), spawn_pool()),
    foreach ({M,BQ,BR,L,D,_} in Arms) printf("LAYOUT arm %w %d %d %d %d%n", M,BQ,BR,L,D) end,
    foreach ({N,E,Q,R} in Atoms)      printf("LAYOUT atom %w %w %d %d%n", N,E,Q,R) end,
    foreach ({X,Y} in Bonds)          printf("LAYOUT bond %w %w%n", X,Y) end,
    foreach ({Q,R} in Calc)           printf("LAYOUT calc %d %d%n", Q,R) end,
    foreach ({{Q1,R1},{Q2,R2}} in Bd) printf("LAYOUT bonder %d %d %d %d%n", Q1,R1,Q2,R2) end.

% ===========================================================================
% Engine (identical to case3_rigid.pi)
% ===========================================================================

% -- geometry -----------------------------------------------------------------
dvec(0) = {1,0}.
dvec(1) = {0,1}.
dvec(2) = {-1,1}.
dvec(3) = {-1,0}.
dvec(4) = {0,-1}.
dvec(5) = {1,-1}.

on_board(Q,R) => abs(Q) =< radius(), abs(R) =< radius(), abs(Q+R) =< radius().

% axial rotation about (BQ,BR); Delta 1 = cw, 5 = ccw (matches dir index math)
rot_point(1, BQ, BR, Q, R) = {BQ - (R-BR), BR + (Q-BQ) + (R-BR)}.
rot_point(5, BQ, BR, Q, R) = {BQ + (Q-BQ) + (R-BR), BR - (Q-BQ)}.

% -- helpers ------------------------------------------------------------------
norm_pair(X,Y) = cond(X @< Y, {X,Y}, {Y,X}).

elemental(E) => membchk(E, [air, earth, fire, water]).

cell_free(Atoms, Q, R) => not member({_,_,Q,R}, Atoms).

% bond-connected component containing atom X
component(X, Bonds) = fixcomp([X], Bonds).
fixcomp(Comp, Bonds) = Comp1 =>
    New = sort_remove_dups(
            [B : {A,B} in Bonds, membchk(A,Comp), not membchk(B,Comp)] ++
            [A : {A,B} in Bonds, membchk(B,Comp), not membchk(A,Comp)]),
    (New == [] -> Comp1 = Comp ; Comp1 = fixcomp(sort(Comp ++ New), Bonds)).

rotated({N,E,Q,R}, Comp, BQ, BR, Delta) = A1 =>
    (membchk(N, Comp) ->
        {Q1,R1} = rot_point(Delta, BQ, BR, Q, R),
        A1 = {N,E,Q1,R1}
    ;
        A1 = {N,E,Q,R}
    ).

% every atom on the board, not on an arm base, no two atoms on one hex
state_ok(Arms, Atoms) =>
    foreach ({_,_,Q,R} in Atoms)
        on_board(Q,R),
        foreach ({_,BQ,BR,_,_,_} in Arms) {Q,R} != {BQ,BR} end
    end,
    Cells = sort([{Q,R} : {_,_,Q,R} in Atoms]),
    Cells == sort_remove_dups(Cells).

% -- post-state rules: spawn, calcification, bonding (clingo core2 parity) ----
mk_next(Arms, Atoms, Bonds, NSp, Calc, Bd, Pending, S1) =>
    ( NSp < spawn_pool(), {SQ,SR} = spawn_cell(), cell_free(Atoms, SQ, SR) ->
        NSp1 = NSp + 1,
        AtomsA = sort([{NSp1, spawn_type(), SQ, SR} | Atoms])
    ;
        NSp1 = NSp, AtomsA = Atoms
    ),
    AtomsB = apply_calc(AtomsA, Calc),
    Bonds1 = apply_bonds(AtomsB, Bonds, Bd),
    S1 = {Arms, AtomsB, Bonds1, NSp1, Calc, Bd, Pending}.

apply_calc(Atoms, Calc) = sort([calc1(A, Calc) : A in Atoms]).
calc1({N,E,Q,R}, Calc) = A1 =>
    (membchk({Q,R}, Calc), elemental(E) -> A1 = {N,salt,Q,R} ; A1 = {N,E,Q,R}).

apply_bonds(Atoms, Bonds, Bd) = Bonds1 =>
    New = findall(P, (member({{QA,RA},{QB,RB}}, Bd),
                      member({X,_,QA,RA}, Atoms),
                      member({Y,_,QB,RB}, Atoms),
                      X != Y, P = norm_pair(X,Y))),
    Bonds1 = sort_remove_dups(Bonds ++ New).

% -- actions ------------------------------------------------------------------
% placement (setup phase): arm, then calcification glyph, then bonder
action({_Arms, Atoms, Bonds, NSp, _Calc, _Bd, [arm|P]}, S1, Action, Cost) ?=>
    member(BQ, -radius()..radius()), member(BR, -radius()..radius()),
    on_board(BQ, BR),
    not membchk({BQ,BR}, io_cells()),      % parts don't overlap I/O parts
    cell_free(Atoms, BQ, BR),              % bases block hexes
    (pruning() ->
        {SQ,SR} = spawn_cell(), hex_dist(BQ,BR,SQ,SR) == 1,
        (hex_dist(BQ,BR,0,-1) == 1 ; hex_dist(BQ,BR,1,-1) == 1)
    ; true),
    member(D, 0..5),
    {DQ,DR} = dvec(D),
    on_board(BQ+DQ, BR+DR),                % gripper starts on the board
    mk_next([{m1,BQ,BR,1,D,none}], Atoms, Bonds, NSp, [], [], P, S1),
    Action = {place_arm, m1, BQ, BR, 1, D},
    Cost = 1.

action({Arms, Atoms, Bonds, NSp, _Calc, _Bd, [calc|P]}, S1, Action, Cost) ?=>
    Arms = [{_,BQ,BR,_,_,_}],
    member(Q, -radius()..radius()), member(R, -radius()..radius()),
    on_board(Q, R),
    not membchk({Q,R}, io_cells()),
    {Q,R} != {BQ,BR},
    (pruning() -> hex_dist(Q,R,BQ,BR) =< 2 ; true),
    mk_next(Arms, Atoms, Bonds, NSp, [{Q,R}], [], P, S1),
    Action = {place_calc, Q, R},
    Cost = 1.

action({Arms, Atoms, Bonds, NSp, Calc, _Bd, [bonder|P]}, S1, Action, Cost) ?=>
    Arms = [{_,BQ,BR,_,_,_}],
    member(Q1, -radius()..radius()), member(R1, -radius()..radius()),
    on_board(Q1, R1),
    member(D, 0..2),                       % unordered pair: 3 dirs suffice
    {DQ,DR} = dvec(D),
    Q2 = Q1 + DQ, R2 = R1 + DR,
    on_board(Q2, R2),
    foreach ({Q,R} in [{Q1,R1},{Q2,R2}])
        not membchk({Q,R}, io_cells()),
        {Q,R} != {BQ,BR},
        not membchk({Q,R}, Calc),
        (pruning() -> hex_dist(Q,R,BQ,BR) =< 2 ; true)
    end,
    mk_next(Arms, Atoms, Bonds, NSp, Calc, [{{Q1,R1},{Q2,R2}}], P, S1),
    Action = {place_bonder, Q1, R1, Q2, R2},
    Cost = 1.

% rotate: rigid rotation of the held component about the acting arm's base
action({Arms, Atoms, Bonds, NSp, Calc, Bd, []}, S1, Action, Cost) ?=>
    member({Act, Delta}, [{rot_cw,1}, {rot_ccw,5}]),
    select({M,BQ,BR,L,D,Held}, Arms, Rest),
    D1 = (D + Delta) mod 6,
    {DQ,DR} = dvec(D1),
    on_board(BQ + L*DQ, BR + L*DR),        % gripper stays on the board
    Arms1 = sort([{M,BQ,BR,L,D1,Held} | Rest]),
    (Held == none ->
        Atoms1 = Atoms
    ;
        Comp = component(Held, Bonds),
        % may not tear a component atom out of another arm's hand
        foreach ({_,_,_,_,_,H2} in Rest) not membchk(H2, Comp) end,
        Atoms1 = sort([rotated(A, Comp, BQ, BR, Delta) : A in Atoms]),
        state_ok(Arms1, Atoms1)
    ),
    mk_next(Arms1, Atoms1, Bonds, NSp, Calc, Bd, [], S1),
    Action = {M, Act},
    Cost = 1.

% grab: hand empty, an atom (not held by another arm) under the gripper
action({Arms, Atoms, Bonds, NSp, Calc, Bd, []}, S1, Action, Cost) ?=>
    select({M,BQ,BR,L,D,none}, Arms, Rest),
    {DQ,DR} = dvec(D),
    member({X,_,BQ+L*DQ,BR+L*DR}, Atoms),
    foreach ({_,_,_,_,_,H2} in Rest) H2 != X end,
    Arms1 = sort([{M,BQ,BR,L,D,X} | Rest]),
    mk_next(Arms1, Atoms, Bonds, NSp, Calc, Bd, [], S1),
    Action = {M, grab},
    Cost = 1.

% drop
action({Arms, Atoms, Bonds, NSp, Calc, Bd, []}, S1, Action, Cost) =>
    select({M,BQ,BR,L,D,Held}, Arms, Rest),
    Held != none,
    Arms1 = sort([{M,BQ,BR,L,D,none} | Rest]),
    mk_next(Arms1, Atoms, Bonds, NSp, Calc, Bd, [], S1),
    Action = {M, drop},
    Cost = 1.
