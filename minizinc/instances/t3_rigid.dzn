% Test 3: rigid rotation of a pre-bonded 2-atom molecule
% (mirrors asp/rigid_instance.lp, uses core2.lp semantics).
% Arm m1 base (0,0), len 1, orient 0. a1 at (1,0) -- a2 at (2,0), bonded.
% Goal: a1 unheld at (-1,1), a2 unheld at (-2,2) (two cw rotations).
% clingo optimum (fixed layout): 4 = grab, rot_cw, rot_cw, drop.
T = 10;
radius = 2;
nA = 2;
nM = 1;

arm_len = [1];
init_ori = [0];
given_base_q = [0];
given_base_r = [0];

init_q = [1, 2];
init_r = [0, 0];
init_type = [1, 1];       % salt, salt

nInitBond = 1;
init_bond = [| 1, 2 |];

nBonder = 0;
given_bonder = array2d(1..0, 1..4, []);
nCalc = 0;
given_calc = array2d(1..0, 1..2, []);

nProd = 2;
prod_atom = [1, 2];
prod_q = [-1, -2];
prod_r = [1, 2];
prod_type = [0, 0];
require_any_bond = false;

% no reagent spawning, plain product goal (parameters added in phase 3)
nSpawn = 0;
spawn_q = [];
spawn_r = [];
spawn_type = [];
atom_spawn = [0, 0];
atom_rank  = [1, 1];
free_prod_atoms = false;
nProdBond = 0;
prod_bond = array2d(1..0, 1..2, []);
exact_molecule = false;
